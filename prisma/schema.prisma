// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vehicles     Vehicle[]
}

model Vehicle {
  id          String              @id @default(cuid())
  userId      String
  smartcarId  String              @unique
  make        String
  model       String
  year        Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection  VehicleConnection?
  snapshots   VehicleSnapshot[]
  chargeSessions ChargeSession[]
  tripSummaries  DailyTripSummary[]
}

model VehicleConnection {
  id           String   @id @default(cuid())
  vehicleId    String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleSnapshot {
  id              String   @id @default(cuid())
  vehicleId       String
  batteryLevel    Float?
  batteryRange    Float?
  chargingStatus  String?
  isCharging      Boolean  @default(false)
  odometer        Float?
  latitude        Float?
  longitude       Float?
  capturedAt      DateTime @default(now())
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, capturedAt])
}

model ChargeSession {
  id             String    @id @default(cuid())
  vehicleId      String
  startedAt      DateTime
  endedAt        DateTime?
  startBattery   Float?
  endBattery     Float?
  energyAdded    Float?
  createdAt      DateTime  @default(now())
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startedAt])
}

model DailyTripSummary {
  id            String   @id @default(cuid())
  vehicleId     String
  date          DateTime @db.Date
  distanceDriven Float
  createdAt     DateTime @default(now())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, date])
  @@index([vehicleId, date])
}
